# Seeed Studio XIAO ESP32-S3 (ESP32-S3R8): dual core, 8 MB QSPI flash,
# 8 MB octal PSRAM. These defaults make clean builds reproducible.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# XIAO standard I2C pins: D4/SDA=GPIO5 and D5/SCL=GPIO6.
CONFIG_DISPLAY_I2C_SDA_GPIO=5
CONFIG_DISPLAY_I2C_SCL_GPIO=6
